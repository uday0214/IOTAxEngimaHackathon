# Google AI Studio Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Experiment Run Constraints
MAX_EXPERIMENTS=15
RANDOM_SEED=42

# Environment Modes
# Set to 'true' to run offline unit tests with mock LLM responses
MOCK_SUPERVISOR=false
LOG_LEVEL=INFO

# Paths
DATA_RAW_PATH=data/raw/Telco-Customer-Churn.csv
DATA_PROCESSED_DIR=data/processed
ARTIFACTS_DIR=artifacts
